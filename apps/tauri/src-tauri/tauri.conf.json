{
  "build": {
    "distDir": "../src",
    "devPath": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Spendot",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false
    },
    "bundle": {
      "active": true,
      "identifier": "com.spendot.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": ["dmg", "nsis"],
      "resources": [],
      "category": "Finance"
    },
    "systemTray": {
      "iconPath": "icons/tray-green.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Spendot",
        "width": 380,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
